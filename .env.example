# =====================================================================
# Copiar este archivo como ".env" (en la RAIZ del proyecto) y completar
# con los datos reales. El archivo ".env" NUNCA se sube al repositorio
# (ver .gitignore) porque contiene datos sensibles.
# =====================================================================

# --- Entorno --------------------------------------------------------
APP_ENV=DEV
APP_URL=http://localhost:8000
APP_NAME="Biblioteca - Primer Parcial"
APP_SECRET=cambiar-esta-clave-por-una-aleatoria-larga

# --- Base de datos ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=biblioteca_db
DB_USER=root
DB_PASS=

# --- Correo (SMTP real) -----------------------------------------------
# Ejemplo con Gmail: hay que generar una "contraseña de aplicacion" en
# https://myaccount.google.com/apppasswords (no la contraseña normal de la cuenta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_FROM_NAME="Biblioteca - Primer Parcial"
