# El Document Root del servidor debe apuntar SIEMPRE a la carpeta "public/".
# Este archivo es solo una proteccion extra por si alguien configura mal el
# vhost y apunta a la raiz del proyecto: bloquea el acceso directo a todo
# lo que no sea necesario servir (src/, database/, .env, etc.).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
